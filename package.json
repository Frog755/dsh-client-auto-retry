{
  "name": "@frog755/dsh-client-auto-retry",
  "version": "0.5.0",
  "description": "DSH client plugin: automatically resumes recoverable interrupted turns with configurable safety limits.",
  "license": "MIT",
  "author": "Frog755",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "retry",
    "auto-retry",
    "client"
  ],
  "homepage": "https://github.com/Frog755/dsh-client-auto-retry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frog755/dsh-client-auto-retry.git"
  },
  "bugs": {
    "url": "https://github.com/Frog755/dsh-client-auto-retry/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README-EN.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
